{% extends 'base.html.twig' %}

{% block title %}Fiche Artiste{% endblock %}

{% block body %}
<h1 class="pt-2" text-center>Fiche de l'artiste</h1>
<hr>
<div class="row pt-2">
{% set nbAlbums = leArtiste.albums|length %}
    
        <div class="card mb-3">
        <h3 class="card-header">{{leArtiste.nom}}</h3>
        <div class="row">
            <div class="col-3 d-flex align-items-center mx-auto">
                <img class="avatar mx-auto d-block" style="height:auto;width:200px;display:block;" src="{{leArtiste.image}}" alt="Card-Image">
            </div>
                    <div class="col">
                    <div class="card-body">
                    <h5 class="card-title">
                <a href="" class="badge badge-success"> {{nbAlbums}} {% if nbAlbums>1 %} albums {% else %} album {% endif %}</a></h5>
                </div>
                <div class="card-body">
                    <p class="card-text">{{leArtiste.description|raw}}</p>
                </div>
                <ul class="list-group list-group-flush">
          <li class="list-group-item">
            {% if leArtiste.type is not null and leArtiste.type == 0 %}
              Artiste Solo
            {% elseif leArtiste.type is not null and leArtiste.type == 1 %}
              Groupe
            {% endif %}
          </li>
                    <li class="list-group-item"><a href="{{leArtiste.site}}"> Voir Site Web</a></li>
                </ul>
                </div>
            </div>
        </div>
        
    
</div>
<table class="table table-hover mx-auto">
  <thead>
    <tr>
      <th scope="col-3">Photo</th>
      <th scope="col-3">Nom</th>
      <th scope="col-1">Date</th>
      <th scope="col-3">Styles</th>
      <th scope="col-1">Morceau</th>
    </tr>
  </thead>
  <tbody>
  {% for leAlbum in leArtiste.albums %}
        <tr>
        <td><img class="minia"src="{{leAlbum.image}}" alt=""></td>
        <td scope="row"><a href="{{path('ficheAlbum',{'id': leAlbum.id})}}">{{leAlbum.Nom}}</a></td>
        <td>{{leAlbum.Date}}</td>
        <td></td>
        <td>{{leAlbum.morceaux|length}}</td>
        </tr>   
  {% endfor %}
  </tbody>
</table>
{% endblock %}
