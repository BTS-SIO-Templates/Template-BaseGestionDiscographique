{% extends 'base.html.twig' %}

{% block stylesheets %}

{% endblock %}

{% block title %}ajout album{% endblock %}

{% block body %}
<h1 class="pt-2" text-center> 
{% if (app.request.attributes.get('_route')=="admin_albums_ajout")%}
Ajout
{% else %}
Modification
{% endif %}
d'un Album</h1>

{{form_start(formAlbum,{'attr':{'novalidate':'novalidate'}})}}

<div class="row">
    <div class="col-8">
        {{form_row(formAlbum.nom)}}
        {{form_row(formAlbum.date)}}
        {{form_row(formAlbum.artiste)}}
        {{form_row(formAlbum.styles)}}
    </div>
    <div class="col-4">
        <div>
          <img src="{{albumimage}}" id="imageAffichee" alt="" class="rounded mx-auto d-block img-thumbnail">
        </div>
        <div>
          {{form_row(formAlbum.image)}}
        </div>
    </div>
</div>

<h3>Liste des Morceaux</h3>
<button type="button" class="add-morceau btn btn-success mb-2">Ajouter un Morceau</button>
<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col-6">Titre</th>
      <th scope="col-2">Durée</th>
      <th scope="col-2">Piste</th>
      <th scope="col-2"></th>
    </tr>
  </thead>
  <tbody id="sousForm" data-index="{{ formAlbum.morceaux|length>0? formAlbum.morceaux|last.vars.name+1:0 }}" data-prototype={{_self.afficheMorceau(formAlbum.morceaux.vars.prototype)|e('html_attr')}}>
  {% for morceau in formAlbum.morceaux %}
    {{_self.afficheMorceau(morceau)}}
  {% endfor %}


  {% macro afficheMorceau(morceau) %}
    <tr>
      <td class="col-6">{{ form_row(morceau.titre) }}</td>
      <td class="col-2">{{ form_row(morceau.duree) }}</td>
      <td class="col-2">{{ form_row(morceau.piste) }}</td>
      <td class="col-2"><a class="supprMorceau btn btn-danger"><i class="fas fa-trash"></i></a></td>
    </tr>
  {% endmacro %}
  </tbody>
</table>


<div class="row">
  <div class="col"><input type="submit" ,value="valider" class="btn btn-success btn-block"></div>
  <div class="col"><a href="{{path('admin_albums')}}" class="btn btn-danger btn-block">Annuler</a></div>
</div>
{{form_end(formAlbum)}}



{% endblock %}
{% block javascripts %}
{{ parent() }}

{# <script src="{{asset("js/gestionUpload.js")}}" defer ></script> #}
<script>
window.onload=()=>{
  const btn_add_morceau=document.querySelector(".add-morceau");
  btn_add_morceau.addEventListener("click",addFromToCollection);
  listenSuppr();
};

function addFromToCollection(){
  const collection=document.querySelector("#sousForm");
  let index=collection.dataset.index;
  let prototype=collection.dataset.prototype;
  prototype=prototype.replace(/__name__/g,index);
  let elementAAjouter=document.createElement("tr");
  elementAAjouter.innerHTML=prototype;
  collection.appendChild(elementAAjouter);
  collection.dataset.index++;
  listenSuppr();
};

function listenSuppr(){
  const btns_suppr=document.querySelectorAll(".supprMorceau");
  btns_suppr.forEach((btn)=>{
    btn.addEventListener("click",function(){
      this.parentNode.parentNode.remove();
    });
  });
}


</script>


{% endblock %}

