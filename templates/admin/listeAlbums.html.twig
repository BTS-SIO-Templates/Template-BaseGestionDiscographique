{% extends 'base.html.twig' %}

{% block title %}gestion albums{% endblock %}

{% block body %}
<h1 class="pt-2" text-center>Gestion des Albums</h1>
<a href="{{ path('admin_albums_ajout') }}" class="btn btn-success">Ajouter un album</a>
{{ form_start(formFiltreAlbum) }}
<div class="row">
  <div class="col">{{ form_row(formFiltreAlbum.nom) }}</div>
  <div class="col">{{ form_row(formFiltreAlbum.artiste) }}</div>
  <div class="col">{{ form_row(formFiltreAlbum.styles) }}</div>
</div>
<button type="submit" class="btn btn-primary">Rechercher</button>
{{ form_end(formFiltreAlbum) }}
<hr>
    <table class="table table-hover">
  <thead>
    <tr>
      <th scope="col-1"></th>
      <th scope="col-2">Nom</th>
      <th scope="col-1">Année</th>
      <th scope="col-2">Artiste</th>
      <th scope="col-2">Styles</th>
      <th scope="col-2">Morceaux</th>
      <th scope="col-3">Actions</th>
    </tr>
  </thead>
{% for leAlbum in lesAlbums %}
{% set nbMorceaux = leAlbum.morceaux|length %}
  <tbody>
    <tr>
      <td class="col-1"><img class="avatar mx-auto d-block" style="height:auto;width:50px;display:block;" src="{{asset("images/albums/" ~ leAlbum.image)}}" alt="Card-Image"></td>
      <td class="col-2">{{leAlbum.nom}}</td>
      <td class="col-1">{{leAlbum.date}}</td>
      <td class="col-2">{{leAlbum.artiste.nom}}</td>
      <td class="col-2">
        {% for style in leAlbum.styles %}
          <span class="badge" style="background-color: {{style.couleur}};">{{style.nom}}</span>
        {% endfor %}
      </td>
      <td class="col-2"><span class="badge badge-success">{{nbMorceaux}}{% if nbMorceaux > 1 %} morceaux{% else %} morceau{% endif %}
      </span></td>
      <td class="col-3">
        <a href="{{path('admin_albums_modif', {'id': leAlbum.id})}}" class="btn btn-warning"><i class="fa-solid fa-pen"></i></a>
        <!-- Button trigger modal -->
        <a  type="button" class="btn btn-danger" 
        data-toggle="modal" 
        data-target="#modalSimple"
        data-titre="Suppression d'un album"
        data-message="Etes vous sur de vouloir supprimer : {{leAlbum.nom}}"
        data-libbtn="Supprimer l'album"
        data-lien="{{path('admin_albums_suppression', {'id': leAlbum.id})}}"
        ><i class="fa-solid fa-trash"></i></a>
      </td>
    </tr>
{% endfor %}
  </tbody>
</table>
    <div class="navigation mx-auto">
    {{ knp_pagination_render(lesAlbums) }}
    </div>
</div>
{% endblock %}
  {% block javascripts %}
    {{ parent() }}
    {% include "include/_modal.html.twig" %}
  {% endblock %}
